# Environment contract for rel_mcp.
# These are exactly the names the code reads — test_env_contract checks this.
# If a variable is added or renamed in the code, it must show up here too.

# ─── Runtime ─────────────────────────────────────────────────
# local | staging | production
ENVIRONMENT=local

# If true, nothing reaches the real world — the safe default.
# Set it to false manually when you're ready for a real deployment.
DRY_RUN=true

# ─── Google ───────────────────────────────────────────────────
# OAuth client file downloaded from Google Cloud (Desktop app).
GOOGLE_CREDENTIALS_PATH=credentials.json

# The token generated after the first consent — stored with 600
# permissions. In .gitignore, must never be committed.
GOOGLE_TOKEN_PATH=var/token.json

# ─── State and audit ──────────────────────────────────────────
# The audit log — append-only, never cleared.
AUDIT_LOG_PATH=var/audit.jsonl

# The relationship ledger — SQLite.
STATE_DB_PATH=var/state.db

# ─── Behavior ─────────────────────────────────────────────────
TIMEZONE=Asia/Riyadh

# Email of the account owner whose calendar/inbox this connects to. Must
# match the account that granted OAuth consent.
OWNER_EMAIL=you@example.com

# This file existing on disk = immediate stop for every action. It is
# never created automatically.
KILL_SWITCH_PATH=var/STOP

# ─── Speech-to-text (Munsit, P21) ──────────────────────────────
# Optional — only needed if you're transcribing meetings. Munsit API
# key, get one from https://app.cntxt.tools/
MUNSIT_API_KEY=

# ─── Meeting recording bot (Meeting BaaS, P21) ─────────────────
# Optional — only needed if you're using a bot that joins meetings to
# record them. Meeting BaaS key, get one from
# https://dashboard.meetingbaas.com/
MEETINGBAAS_API_KEY=

# ─── Speech-to-text — ElevenLabs Scribe (P21) ──────────────────
# Optional — alternative to Munsit, higher quality in initial testing.
# Get the key from https://elevenlabs.io/
ELEVENLABS_API_KEY=

# ─── LLM-based meeting summarization (meeting_summary.py, P21) ─
# Optional — only needed if you're summarizing transcripts. A separate
# OpenRouter key from the one Hermes holds for the conversational model
# (auth.json) — see meeting_summary.py for why they're separate. Get
# one from https://openrouter.ai/
OPENROUTER_API_KEY=

# ─── Identity-handover check (reset_identity.py / verify_identity.py) ─
# Optional — a comma-separated list of the developer's own personal
# email addresses, used only by the handover scripts to confirm no
# trace of the developer's account remains before the owner takes over
# the agent. Not needed for normal operation.
DEV_OWNER_EMAILS=
