# عقد البيئة لـ rel_mcp.
# الأسماء دى بالظبط اللى الكود بيقراها — test_env_contract بيتأكد من ده.
# لو حد ضاف أو غيّر متغير فى الكود، لازم يظهر هنا أيضًا.

# ─── بيئة التشغيل ─────────────────────────────────────────────
# local | staging | production
ENVIRONMENT=local

# لو true، مافيش أى فعل بيوصل للعالم الحقيقى — التقصير الآمن.
# لازم تخليها false يدويًا لما تجهزى للنشر الحقيقى.
DRY_RUN=true

# ─── جوجل ─────────────────────────────────────────────────────
# ملف OAuth client المنزّل من Google Cloud (Desktop app).
GOOGLE_CREDENTIALS_PATH=credentials.json

# التوكن اللى بيتولّد بعد أول موافقة — بيتخزن بصلاحيات 600.
# فى .gitignore، ماينفعش يتعمله كوميت.
GOOGLE_TOKEN_PATH=var/token.json

# ─── حالة وتدقيق ──────────────────────────────────────────────
# سجل التدقيق — يضاف عليه، مايُمسح أبدًا.
AUDIT_LOG_PATH=var/audit.jsonl

# سجل العلاقات — SQLite.
STATE_DB_PATH=var/state.db

# ─── سلوك ─────────────────────────────────────────────────────
TIMEZONE=Asia/Riyadh

# إيميل مالك الحساب المتصل. لازم يطابق الحساب اللى وافق على OAuth.
# أثناء التطوير: إيميل المطوّرة. عند التسليم: إيميل العميل — راجع P11.5.
OWNER_EMAIL=hagagmariam813@gmail.com

# وجود الملف ده على القرص = إيقاف فورى لأى فعل. مايُنشأش تلقائيًا.
KILL_SWITCH_PATH=var/STOP

# ─── تفريغ صوتي (Munsit، P21) ──────────────────────────────────
# اختيارى — لازم بس لو هتستخدمى تفريغ الاجتماعات. مفتاح Munsit API،
# احصلى عليه من https://app.cntxt.tools/
MUNSIT_API_KEY=

# ─── بوت تسجيل الاجتماعات (Meeting BaaS، P21) ───────────────────
# اختيارى — لازم بس لو هتستخدمى بوت يدخل الاجتماعات يسجّلها. مفتاح
# Meeting BaaS، احصلى عليه من https://dashboard.meetingbaas.com/
MEETINGBAAS_API_KEY=

# ─── تفريغ صوتي — ElevenLabs Scribe (P21) ────────────────────────
# اختيارى — بديل لـ Munsit، جودة أعلى فى الاختبار الأولى على عربي
# مصري. احصلى على المفتاح من https://elevenlabs.io/
ELEVENLABS_API_KEY=

# ─── تلخيص محاضر الاجتماعات عبر LLM (meeting_summary.py، P21) ────
# اختيارى — لازم بس لو هتستخدمى تلخيص الترانسكريبت. مفتاح OpenRouter
# منفصل عن مفتاح Hermes الخاص بالموديل التخاطبى (auth.json) — راجع
# meeting_summary.py لسبب الفصل. احصلى عليه من https://openrouter.ai/
OPENROUTER_API_KEY=

# ─── فحص تسليم الهوية (reset_identity.py / verify_identity.py) ───
# اختيارى — قائمة إيميلات المطوّر/المطوّرة الشخصية، مفصولة بفاصلة،
# تستخدمها سكربتات التسليم بس عشان تتأكد إن مفيش أثر لحساب المطوّر
# فاضل قبل ما يتسلّم العميل الوكيل. مش لازمة للتشغيل العادي.
DEV_OWNER_EMAILS=
